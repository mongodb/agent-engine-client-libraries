# LLM credentials. The sample app keeps model defaults in source and infers the
# provider from the available API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Memory (required because test-agent enables features.memory in agent.yaml)
VOYAGE_API_KEY=

# Database names. Leave unset to use the managed mdb_store and mdb_memory bases,
# which the platform scopes with _{project_id}. Overrides are used exactly.
# MDB_AGENTIC_STORE_DB=custom_store
# MONGOMEM_DB_NAME=custom_memory
