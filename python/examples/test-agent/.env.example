# MONGODB_URI is only required when mongodb.local is false in agent.yaml.
# By default, a local MongoDB Atlas container is started automatically.
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net

# LLM credentials. The sample app keeps model defaults in source and infers the
# provider from the available API key.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...
