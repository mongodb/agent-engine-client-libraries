# MongoDB Connection
MONGODB_URI="atlas dedicated cluster connection string"

# Database names. Leave unset to use the managed mdb_store and mdb_memory bases,
# which the platform scopes with _{project_id}. Overrides are used exactly.
# MDB_AGENTIC_STORE_DB=custom_store
# MONGOMEM_DB_NAME=custom_memory

# Guardrails endpoint
GUARDRAILS_SERVER_URL=

# LLM credentials. DEFAULT_PROVIDER and DEFAULT_MODELS in
# src/insurance_agent/main.py pin the provider and model. Base URLs remain
# environment-specific overrides.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Embedder credentials (required when features.memory is true)
VOYAGE_API_KEY=
# If using Voyage API keys from Atlas non-prod (e.g. cloud-dev.mongodb.com),
# set the Voyage API URL to the appropriate endpoint (e.g. https://ai-dev.mongodb.com/v1)
# VOYAGE_URL=
