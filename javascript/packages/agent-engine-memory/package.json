{
  "name": "@mongodb-js/agent-engine-sdk-memory",
  "version": "0.11.3",
  "description": "Unified Memory facade for the Atlas Agent Engine SDK (TypeScript)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mongodb/agent-engine-client-libraries.git",
    "directory": "javascript/packages/agent-engine-memory"
  },
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@mongodb-js/agent-engine-sdk": "0.11.3",
    "zod": "^4.4.3"
  }
}
