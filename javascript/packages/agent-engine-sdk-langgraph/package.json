{
  "name": "@mongodb-js/agent-engine-sdk-langgraph",
  "version": "0.11.7",
  "description": "Atlas Agent Engine LangGraph SDK for building secure, observable agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mongodb/agent-engine-client-libraries.git",
    "directory": "javascript/packages/agent-engine-sdk-langgraph"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-langchain": "4.0.23",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-mongodb": "^1.3.0",
    "@langchain/openai": "^1.4.5",
    "@mongodb-js/agent-engine-sdk-memory": "0.11.7",
    "@mongodb-js/agent-engine-runner-shared": "0.11.7",
    "@mongodb-js/agent-engine-sdk": "0.11.7",
    "deepagents": "^1.10.2",
    "langchain": "^1.0.0",
    "mongodb": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "packageManager": "npm@11.14.1"
}
