{
  "name": "@mongodb-js/agent-engine-sdk",
  "version": "0.11.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/10gen/agentic-platform.git",
    "directory": "client-libraries/packages/javascript/packages/agent-engine-sdk"
  },
  "description": "Core TypeScript protocols and models for the Atlas Agent Engine SDK",
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10.0"
  },
  "main": "./dist/index.js",
